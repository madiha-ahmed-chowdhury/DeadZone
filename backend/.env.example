# DeadZone backend — copy to .env and fill in real values

# Supabase
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=ey...replace-with-service-role-key...

# Telegram bot (from @BotFather)
TELEGRAM_BOT_TOKEN=0000000000:replace-with-real-token

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: set to "true" to skip Supabase writes during local UI development
# (useful when iterating on the frontend without DB credentials)
DEADZONE_DRY_RUN=false

# Shared secret required on write endpoints (create pulse/need, update need
# status). Leave blank for local dev. SET THIS before deploying anywhere
# public — otherwise anyone with the URL can forge safety signals or mark
# real aid requests "fulfilled". The bot and dashboard must both send it.
BACKEND_API_KEY=